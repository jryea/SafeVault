@page
@model SafeVault.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row">
    <div class="col-md-6">
        <h2>Sign In</h2>
        <form method="post" asp-page-handler="Login">
            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label"></label>
                <input asp-for="Input.Username" class="form-control" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Login</button>
        </form>
    </div>

    <div class="col-md-6">
        <h2>Register</h2>
        <form method="post" asp-page-handler="Register">
            <div class="mb-3">
                <label asp-for="Register.Username" class="form-label"></label>
                <input asp-for="Register.Username" class="form-control" />
                <span asp-validation-for="Register.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Register.Email" class="form-label"></label>
                <input asp-for="Register.Email" class="form-control" />
                <span asp-validation-for="Register.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Register.Password" class="form-label"></label>
                <input asp-for="Register.Password" class="form-control" />
                <span asp-validation-for="Register.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-secondary">Register</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
